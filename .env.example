# ============================================================
#  Salin berkas ini menjadi .env, lalu isi yang dibutuhkan.
#  JANGAN pernah mengunggah .env ke GitHub — sudah ada di .gitignore.
# ============================================================

# Nama panggilan awal (bisa diubah lewat suara atau tab Pengaturan)
SPEAKER_NAME=Bos

# true = pakai Edge TTS (butuh internet), false = langsung Piper luring
USE_ONLINE_TTS=true

# --- Groq (WAJIB untuk akurasi penuh) ---
# Daftar gratis di console.groq.com, lalu buat API key.
# Satu key ini dipakai untuk DUA hal: transkripsi (whisper-large-v3 dan
# turbo) dan penalaran lapis 2 (gpt-oss-20b dan qwen3.8-27b).
# Tanpa key ini AKIRA tetap jalan, tapi hanya dengan Whisper lokal.
GROQ_API_KEY=

# --- Penyetelan suara (opsional) ---
# id-ID-GadisNeural (perempuan) atau id-ID-ArdiNeural (laki-laki)
# EDGE_VOICE=id-ID-GadisNeural
# EDGE_RATE=+18%
# EDGE_PITCH=+0Hz
